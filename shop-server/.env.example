# Copy to shop-server/.env for local runs. Never commit .env.
# Test mode only. Live keys are refused unless STRIPE_ALLOW_LIVE=true.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_SITE_URL=http://127.0.0.1:3710

# Set to false only if Stripe Tax is not turned on yet.
# STRIPE_AUTOMATIC_TAX=false

# Railway: mount a volume at /data and use these paths so stock survives deploys.
# INVENTORY_PATH=/data/inventory.json
# NOTIFY_PATH=/data/notify.json

# Local full-site preview (serves the repo plus /api). Leave unset on the API-only Railway service.
# SERVE_STATIC=true

# Sample success page at /shop/success/?session_id=cs_test_preview. Keep false in production.
# ALLOW_CHECKOUT_PREVIEW=false

# Extra browser origins, comma-separated. domokuncafe.com and www are already allowed.
# CORS_ORIGINS=

# PORT=3710
